// ERP POS System - Prisma Schema
// MVP Database Schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Authentication & Authorization
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  INVENTORY_MANAGER
  QC_MANAGER
  SUPERVISOR
  WORKER
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  pin           String?   // Hashed PIN for quick POS login
  role          UserRole  @default(WORKER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth fields
  emailVerified Boolean   @default(false)
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Relations
  orders        Order[]
  auditLogs     AuditLog[]

  @@map("users")
}

// Better Auth required models
model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────
// Inventory & Products
// ─────────────────────────────────────────────

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@map("suppliers")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(uuid())
  name          String
  sku           String    @unique
  barcode       String?   @unique
  description   String?
  price         Decimal   @db.Decimal(12, 2)
  costPrice     Decimal?  @db.Decimal(12, 2)
  taxRate       Decimal   @default(0) @db.Decimal(5, 2) // GST percentage
  hsnCode       String?   // HSN/SAC code for GST compliance
  unit          String    @default("PCS") // PCS, KG, LTR, etc.
  stockQuantity Int       @default(0)
  minStockAlert Int       @default(10)
  batchNumber   String?
  expiryDate    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])

  orderItems    OrderItem[]
  inventoryTxns InventoryTransaction[]

  @@index([barcode])
  @@index([sku])
  @@map("products")
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  transactionType String   // IN, OUT, ADJUSTMENT
  quantity        Int
  reason          String?  // e.g. "Stock inward scan", "Sale", "Manual adjustment"
  referenceId     String?  // Link to order ID or purchase order
  createdAt       DateTime @default(now())

  @@index([productId])
  @@map("inventory_transactions")
}

// ─────────────────────────────────────────────
// Orders & Billing
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  SPLIT
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // Human-readable: e.g. ORD-20260529-001
  cashierId       String
  cashier         User          @relation(fields: [cashierId], references: [id])
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(CASH)
  status          OrderStatus   @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  payments        Payment[]

  @@index([cashierId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

// Split payment support
model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?       // UPI transaction ID, card last 4, etc.
  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@map("payments")
}

// ─────────────────────────────────────────────
// Audit & Compliance
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // CREATE_ORDER, VOID_ORDER, UPDATE_STOCK, etc.
  entity    String   // Order, Product, User, etc.
  entityId  String
  details   String?  // JSON string of changes
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
